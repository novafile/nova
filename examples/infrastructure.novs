# Schema for the infrastructure examples (spec §6).
@schema infrastructure/v1
@root Infrastructure

type Port = u16 @range(1..65535)

record Service:
  id: string @key @id(1)
  image: string @len(1..) @id(2)
  port: Port @id(3)
  replicas: u16 @range(0..100) @id(4)
  enabled: bool @id(5) = true
  tags?: set<string> @id(6)

enum Status:
  active
  draining
  failed(string)

record Infrastructure:
  environment: string
  region: string
  deployed_at: timestamp
  status: Status = !active
  services: Service[]
